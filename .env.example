# Hyperliquid: use a dedicated approved API/agent wallet. The account address
# is the actual master/subaccount whose private stream is queried.
HYPERLIQUID_AGENT_PRIVATE_KEY=
HYPERLIQUID_ACCOUNT_ADDRESS=
# Optional: add `vault_address_env = "HYPERLIQUID_VAULT_ADDRESS"` to the
# Hyperliquid gateway config. It must equal HYPERLIQUID_ACCOUNT_ADDRESS.
HYPERLIQUID_VAULT_ADDRESS=

# Lighter: provision an API key offline. Prefer a maker-only key when the
# account tier supports it. The live quoter does not need an Ethereum L1 key.
LIGHTER_SIGNER_LIBRARY_PATH=
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=
